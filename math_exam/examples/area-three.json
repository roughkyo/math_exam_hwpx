          "y": 313,
          "size": 11,
          "width": 300,
          "height": 25
        },
        {
          "type": "equation",
          "script": "x(x-3)=0~~THEREFORE~~x=0, 3",
          "x": 75,
          "y": 350,
          "size": 11,
          "width": 300,
          "height": 25
        },
        {
          "type": "text",
          "text": "이 구간에서 포물선이 위에 있으므로",
