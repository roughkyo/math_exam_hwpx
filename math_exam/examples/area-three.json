          "y": 740,
          "size": 11,
          "width": 305,
          "height": 22.7
        },
        {
          "type": "equation",
          "script": "t=x-1, S=int_{-b}^{b} (b^2-t^2)dt={4} over {3}b^3",
          "x": 75,
          "y": 780,
          "size": 11,
          "width": 300,
          "height": 45
        },
        {
          "type": "equation",
          "script": "{4} over {3}b^3={32} over {3}~~THEREFORE~~b=2",
          "x": 75,
          "y": 840,
          "size": 11,
          "width": 300,
          "height": 40
        },
        {
          "type": "equation",
          "script": "1+a=4~~THEREFORE~~a=3",
