          "width": 305,
          "height": 22.7
        },
        {
          "type": "equation",
          "script": "1-b, 1+b",
          "x": 75,
          "y": 700,
          "size": 11,
          "width": 300,
          "height": 25
        },
        {
          "type": "text",
          "text": "이다. 적분 구간의 중심을 원점으로 옮기면",
